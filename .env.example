# Copy this file to .env and fill in local values. Never commit .env.

# Azure OpenAI (required for the azure_openai profile)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=

# Ollama (canonical local model identifiers)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLAMA_MODEL=llama3.2:3b
OLLAMA_GPT_OSS_MODEL=gpt-oss:120b-cloud

# Optional default profile: azure_openai, ollama_llama, or ollama_gpt_oss
LLM_PROFILE=

# Legacy compatibility
USE_OLLAMA=
OLLAMA_MODEL=llama3.2:3b
GEMINI_API_KEY=

# W&B remains optional for later training work.
W&B_API_KEY=
