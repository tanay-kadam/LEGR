{
  "name": "math_1",
  "tier": 15,
  "model": {
    "text_model": "sentence-transformers/all-MiniLM-L6-v2",
    "graph_kind": "v3",
    "structure_kind": "combined",
    "readout_kind": "dual_attention",
    "fusion_kind": "gated",
    "hidden_dim": 256,
    "embed_dim": 256,
    "graph_layers": 4,
    "attention_heads": 8,
    "dropout": 0.1,
    "rerank_k": 20,
    "rerank_layers": 2,
    "use_reranker": false,
    "use_semantic_expert": true,
    "unfreeze": "last2"
  },
  "loss": {
    "rank_kind": "listwise",
    "use_multi_positive": true,
    "use_twin": false,
    "use_tool": false,
    "use_relation": false,
    "use_distance": false,
    "listwise_weight": 1.0,
    "twin_weight": 1.0,
    "tool_weight": 0.5,
    "relation_weight": 1.0,
    "multi_positive_weight": 0.1,
    "distance_weight": 0.1,
    "margin": 0.2,
    "temperature": 0.05
  },
  "train": {
    "seed": 42,
    "epochs": 15,
    "batch_size": 64,
    "lr": 0.0002,
    "backbone_lr": 2e-05,
    "weight_decay": 0.0001,
    "warmup_epochs": 2,
    "patience": 6,
    "max_grad_norm": 1.0,
    "schedule": "cosine",
    "group_aware": true,
    "use_ema": false,
    "use_swa": false,
    "online_hard_negatives": false,
    "curriculum": false,
    "device": "cuda",
    "num_workers": 0,
    "max_length": 128
  }
}